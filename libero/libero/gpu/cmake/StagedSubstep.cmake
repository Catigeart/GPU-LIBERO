# Optional coarse FP64 baseline. Each region is an independent CUDA object;
# Newton/OSC/Post/vendor objects are the same objects as the fused product.
function(flash_add_staged_substep suffix mathdx_input mathdx_target osc_input osc_target)
  if(NOT FLASH_SUBSTEP_THREADS STREQUAL "64")
    return()
  endif()
  set(inputs)
  foreach(region forward newton post)
    set(object flash_staged_${region}${suffix})
    flash_object(${object} "${FLASH_STEP}/staged_${region}.cu" 64)
    target_compile_definitions(${object} PRIVATE ${ARGN})
    target_compile_options(${object} PRIVATE --split-compile=3)
    set_target_properties(${object} PROPERTIES EXCLUDE_FROM_ALL TRUE)
    if(FLASH_GLOBAL_DEVICE_LTO)
      set_target_properties(${object} PROPERTIES CUDA_ARCHITECTURES OFF)
      target_compile_options(${object} PRIVATE "-arch=lto_${FLASH_CUDA_ARCH}" -dlto)
    endif()
    list(APPEND inputs $<TARGET_OBJECTS:${object}>)
  endforeach()
  set(modes normal ordered)
  foreach(mode IN LISTS modes)
    set(product substep_staged${suffix})
    set(solver flash_newton_solver${suffix})
    if(mode STREQUAL ordered)
      string(APPEND product _ordered)
      if(FLASH_NEWTON_ATOMIC_REDUCTIONS)
        set(solver flash_newton_solver_ordered${suffix})
      endif()
    endif()
    set(reduction_inputs)
    if(FLASH_NEWTON_ATOMIC_REDUCTIONS AND mode STREQUAL normal)
      set(reduction_inputs $<TARGET_OBJECTS:flash_newton_atomic>
        $<TARGET_OBJECTS:flash_newton_transpose> $<TARGET_OBJECTS:flash_newton_jacobian_cache>)
    endif()
    set(target flash_${product})
    add_library(${target} SHARED EXCLUDE_FROM_ALL "${FLASH_STEP}/staged_launch.cu" ${inputs}
      $<TARGET_OBJECTS:${solver}> $<TARGET_OBJECTS:flash_post_solver>
      $<TARGET_OBJECTS:flash_osc_solver> $<TARGET_OBJECTS:flash_controller_pipeline>
      ${reduction_inputs} ${mathdx_input} ${osc_input})
    target_compile_definitions(${target} PRIVATE ${ARGN})
    target_link_libraries(${target} PRIVATE flash_cuda_options)
    add_dependencies(${target} ${mathdx_target} ${osc_target})
    set_target_properties(${target} PROPERTIES OUTPUT_NAME ${product} PREFIX ""
      CUDA_SEPARABLE_COMPILATION ON CUDA_RESOLVE_DEVICE_SYMBOLS ON
      CUDA_ARCHITECTURES "${FLASH_CUDA_ARCH}-real" UNITY_BUILD OFF JOB_POOL_LINK flash_cuda_link)
    target_link_options(${target} PRIVATE "$<HOST_LINK:LINKER:--no-undefined>")
    if(FLASH_GLOBAL_DEVICE_LTO)
      target_link_options(${target} PRIVATE "$<DEVICE_LINK:-dlto>")
      target_link_libraries(${target} PRIVATE "${FLASH_SOLVERDX}")
    endif()
    if(mode STREQUAL normal)
      set_property(GLOBAL APPEND PROPERTY FLASH_STAGED_TARGETS ${target})
    else()
      set_property(GLOBAL APPEND PROPERTY FLASH_STAGED_ORDERED_TARGETS ${target})
    endif()
  endforeach()
endfunction()
