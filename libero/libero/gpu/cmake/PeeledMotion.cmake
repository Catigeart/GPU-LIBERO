# Dimension-general motion/force producers and one residual per NV/product.
function(flash_add_peeled_motion suffix mathdx_input mathdx_target osc_input osc_target)
  if(NOT FLASH_SUBSTEP_THREADS STREQUAL "64")
    return()
  endif()
  if(NOT TARGET flash_fp64_motion_passive)
    flash_object(flash_fp64_motion_passive "${FLASH_STEP}/fp64_motion_passive.cu" 64)
    set_target_properties(flash_fp64_motion_passive PROPERTIES EXCLUDE_FROM_ALL TRUE)
    target_compile_options(flash_fp64_motion_passive PRIVATE --split-compile=3)
    if(FLASH_GLOBAL_DEVICE_LTO)
      set_target_properties(flash_fp64_motion_passive PROPERTIES CUDA_ARCHITECTURES OFF)
      target_compile_options(flash_fp64_motion_passive PRIVATE "-arch=lto_${FLASH_CUDA_ARCH}" -dlto)
    endif()
  endif()
  if(NOT TARGET flash_fp64_actuation_solve)
    flash_object(flash_fp64_actuation_solve "${FLASH_STEP}/fp64_actuation_solve.cu" 64)
    set_target_properties(flash_fp64_actuation_solve PROPERTIES EXCLUDE_FROM_ALL TRUE)
    target_compile_options(flash_fp64_actuation_solve PRIVATE --split-compile=3)
    if(FLASH_GLOBAL_DEVICE_LTO)
      set_target_properties(flash_fp64_actuation_solve PROPERTIES CUDA_ARCHITECTURES OFF)
      target_compile_options(flash_fp64_actuation_solve PRIVATE "-arch=lto_${FLASH_CUDA_ARCH}" -dlto)
    endif()
  endif()
  foreach(flavor motion force)
    string(TOUPPER "${flavor}" flavor_key)
    set(launch "${FLASH_STEP}/fp64_motion_launch.cu")
    set(extra_objects)
    set(extra_definitions)
    if(flavor STREQUAL force)
      set(launch "${FLASH_STEP}/fp64_force_launch.cu")
      set(extra_objects $<TARGET_OBJECTS:flash_fp64_actuation_solve>)
      set(extra_definitions FLASH_FP64_ACTUATION_SOLVE=1)
    endif()
    set(residual flash_${flavor}_residual${suffix})
    flash_object(${residual} "${FLASH_STEP}/fused_substep.cu" 64)
    target_compile_definitions(${residual} PRIVATE ${ARGN} FLASH_FP64_MOTION_PASSIVE=1 ${extra_definitions})
    target_compile_options(${residual} PRIVATE --split-compile=3)
    set_target_properties(${residual} PROPERTIES EXCLUDE_FROM_ALL TRUE)
    if(FLASH_GLOBAL_DEVICE_LTO)
      set_target_properties(${residual} PROPERTIES CUDA_ARCHITECTURES OFF)
      target_compile_options(${residual} PRIVATE "-arch=lto_${FLASH_CUDA_ARCH}" -dlto)
    endif()
    foreach(mode normal ordered)
      set(product substep_${flavor}${suffix})
      set(solver flash_newton_solver${suffix})
      if(mode STREQUAL ordered)
        string(APPEND product _ordered)
        if(FLASH_NEWTON_ATOMIC_REDUCTIONS)
          set(solver flash_newton_solver_ordered${suffix})
        endif()
      endif()
      set(reductions)
      if(FLASH_NEWTON_ATOMIC_REDUCTIONS AND mode STREQUAL normal)
        set(reductions $<TARGET_OBJECTS:flash_newton_atomic>
          $<TARGET_OBJECTS:flash_newton_transpose> $<TARGET_OBJECTS:flash_newton_jacobian_cache>)
      endif()
      set(target flash_${product})
      add_library(${target} SHARED EXCLUDE_FROM_ALL ${launch}
        $<TARGET_OBJECTS:flash_fp64_motion_passive> ${extra_objects} $<TARGET_OBJECTS:${residual}>
        $<TARGET_OBJECTS:${solver}> $<TARGET_OBJECTS:flash_post_solver>
        $<TARGET_OBJECTS:flash_osc_solver> $<TARGET_OBJECTS:flash_controller_pipeline>
        ${reductions} ${mathdx_input} ${osc_input})
      target_compile_definitions(${target} PRIVATE ${ARGN})
      target_link_libraries(${target} PRIVATE flash_cuda_options)
      add_dependencies(${target} ${mathdx_target} ${osc_target})
      set_target_properties(${target} PROPERTIES OUTPUT_NAME ${product} PREFIX ""
        CUDA_SEPARABLE_COMPILATION ON CUDA_RESOLVE_DEVICE_SYMBOLS ON
        CUDA_ARCHITECTURES "${FLASH_CUDA_ARCH}-real" UNITY_BUILD OFF JOB_POOL_LINK flash_cuda_link)
      target_link_options(${target} PRIVATE "$<HOST_LINK:LINKER:--no-undefined>")
      if(FLASH_GLOBAL_DEVICE_LTO)
        target_link_options(${target} PRIVATE "$<DEVICE_LINK:-dlto>")
        target_link_libraries(${target} PRIVATE "${FLASH_SOLVERDX}")
      endif()
      if(mode STREQUAL normal)
        set_property(GLOBAL APPEND PROPERTY FLASH_${flavor_key}_TARGETS ${target})
      endif()
    endforeach()
  endforeach()
endfunction()
