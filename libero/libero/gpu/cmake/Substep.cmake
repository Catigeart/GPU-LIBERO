function(flash_variant nv nq nm nj nu)
  set(suffix "_nv${nv}")
  if(nv EQUAL 39)
    set(suffix "") # Preserve the original development target and binary.
  endif()
  set(definitions FLASH_SUBSTEP_NV=${nv} FLASH_SUBSTEP_NQ=${nq} FLASH_SUBSTEP_NM=${nm}
    FLASH_SUBSTEP_NJ=${nj} FLASH_SUBSTEP_NU=${nu} FLASH_SUBSTEP_CONTACTS=5000)
  flash_mathdx(flash_newton_mathdx${suffix} "${FLASH_STEP}/instantiations/newton_mathdx.cu" ${definitions})
  set(mathdx_input "${FLASH_VENDOR_INPUT}")
  set(mathdx_target ${FLASH_VENDOR_TARGET})
  foreach(module fused_substep newton_solver)
    set(object flash_${module}${suffix})
    flash_object(${object} "${FLASH_STEP}/${module}.cu")
    target_compile_definitions(${object} PRIVATE ${definitions})
    if(module STREQUAL newton_solver)
      target_compile_definitions(${object} PRIVATE
        FLASH_NEWTON_ATOMIC_REDUCTIONS=$<BOOL:${FLASH_NEWTON_ATOMIC_REDUCTIONS}>)
    endif()
    target_compile_options(${object} PRIVATE --split-compile=3)
    if(FLASH_GLOBAL_DEVICE_LTO)
      set_target_properties(${object} PROPERTIES CUDA_ARCHITECTURES OFF)
      target_compile_options(${object} PRIVATE "-arch=lto_${FLASH_CUDA_ARCH}" -dlto)
    endif()
  endforeach()
  set(profile_solver flash_newton_solver_profile${suffix})
  # Keep full-substep markers out of the normal numerical object.
  set(profile_fused flash_fused_substep_profile${suffix})
  flash_object(${profile_fused} "${FLASH_STEP}/fused_substep.cu")
  set_target_properties(${profile_fused} PROPERTIES EXCLUDE_FROM_ALL TRUE)
  target_compile_definitions(${profile_fused} PRIVATE ${definitions} FLASH_SUBSTEP_PROFILE=1)
  target_compile_options(${profile_fused} PRIVATE --split-compile=3)
  if(FLASH_GLOBAL_DEVICE_LTO)
    set_target_properties(${profile_fused} PROPERTIES CUDA_ARCHITECTURES OFF)
    target_compile_options(${profile_fused} PRIVATE "-arch=lto_${FLASH_CUDA_ARCH}" -dlto)
  endif()
  flash_object(${profile_solver} "${FLASH_STEP}/newton_solver.cu")
  set_target_properties(${profile_solver} PROPERTIES EXCLUDE_FROM_ALL TRUE)
  target_compile_definitions(${profile_solver} PRIVATE ${definitions} FLASH_NEWTON_PROFILE=1
    FLASH_NEWTON_ATOMIC_REDUCTIONS=$<BOOL:${FLASH_NEWTON_ATOMIC_REDUCTIONS}>)
  target_compile_options(${profile_solver} PRIVATE --split-compile=3)
  if(FLASH_GLOBAL_DEVICE_LTO)
    set_target_properties(${profile_solver} PROPERTIES CUDA_ARCHITECTURES OFF)
    target_compile_options(${profile_solver} PRIVATE "-arch=lto_${FLASH_CUDA_ARCH}" -dlto)
  endif()
  # Ordered comparison products coexist in this build tree. Their optional
  # solver objects share the fusion/vendor objects and require no reconfigure.
  set(ordered_solver flash_newton_solver${suffix})
  set(ordered_profile_solver ${profile_solver})
  if(FLASH_NEWTON_ATOMIC_REDUCTIONS)
    foreach(kind ordered ordered_profile)
      set(object flash_newton_solver_${kind}${suffix})
      flash_object(${object} "${FLASH_STEP}/newton_solver.cu")
      set_target_properties(${object} PROPERTIES EXCLUDE_FROM_ALL TRUE)
      target_compile_definitions(${object} PRIVATE ${definitions} FLASH_NEWTON_ATOMIC_REDUCTIONS=0)
      target_compile_options(${object} PRIVATE --split-compile=3)
      if(kind STREQUAL ordered_profile)
        target_compile_definitions(${object} PRIVATE FLASH_NEWTON_PROFILE=1)
      endif()
      if(FLASH_GLOBAL_DEVICE_LTO)
        set_target_properties(${object} PROPERTIES CUDA_ARCHITECTURES OFF)
        target_compile_options(${object} PRIVATE "-arch=lto_${FLASH_CUDA_ARCH}" -dlto)
      endif()
    endforeach()
    set(ordered_solver flash_newton_solver_ordered${suffix})
    set(ordered_profile_solver flash_newton_solver_ordered_profile${suffix})
  endif()
  foreach(mode normal profile ordered ordered_profile post_profile osc_profile)
    set(product substep${suffix})
    set(solver flash_newton_solver${suffix})
    set(fused flash_fused_substep${suffix})
    set(post flash_post_solver)
    set(osc flash_osc_solver)
    set(pipeline flash_controller_pipeline)
    set(profile_definitions)
    set(excluded)
    set(atomic_input)
    if(FLASH_NEWTON_ATOMIC_REDUCTIONS AND NOT mode MATCHES "ordered")
      set(atomic_input $<TARGET_OBJECTS:flash_newton_atomic>
        $<TARGET_OBJECTS:flash_newton_transpose> $<TARGET_OBJECTS:flash_newton_jacobian_cache>)
    endif()
    if(mode MATCHES "profile")
      set(product substep_newton_profile${suffix})
      set(solver ${profile_solver})
      set(fused ${profile_fused})
      set(post flash_post_solver_profile)
      set(profile_definitions FLASH_SUBSTEP_PROFILE=1)
      set(excluded EXCLUDE_FROM_ALL)
    endif()
    if(mode MATCHES "ordered")
      set(product "${product}_ordered")
      set(solver ${ordered_solver})
      if(mode STREQUAL ordered_profile)
        set(solver ${ordered_profile_solver})
      endif()
      set(excluded EXCLUDE_FROM_ALL)
    endif()
    # Post-only instrumentation reuses the ordinary numerical Newton/fusion
    # objects. Profiling Post never recompiles the Newton iteration body.
    if(mode STREQUAL post_profile)
      set(product substep_post_profile${suffix})
      set(solver flash_newton_solver${suffix})
      set(fused flash_fused_substep${suffix})
      set(post flash_post_solver_profile)
      set(profile_definitions)
      set(excluded EXCLUDE_FROM_ALL)
    endif()
    if(mode STREQUAL osc_profile)
      set(product substep_osc_profile${suffix})
      set(solver flash_newton_solver${suffix})
      set(fused flash_fused_substep${suffix})
      set(post flash_post_solver)
      set(osc flash_osc_solver_profile)
      set(pipeline flash_controller_pipeline_profile)
      set(profile_definitions)
      set(excluded EXCLUDE_FROM_ALL)
    endif()
    set(target flash_${product})
    add_library(${target} SHARED ${excluded} "${FLASH_STEP}/substep_launch.cu"
      $<TARGET_OBJECTS:${fused}> $<TARGET_OBJECTS:${solver}> $<TARGET_OBJECTS:${post}>
      $<TARGET_OBJECTS:${osc}> $<TARGET_OBJECTS:${pipeline}>
      ${atomic_input} ${mathdx_input} ${FLASH_OSC_INPUT})
    target_link_libraries(${target} PRIVATE flash_cuda_options)
    target_compile_definitions(${target} PRIVATE ${definitions} ${profile_definitions})
    add_dependencies(${target} ${mathdx_target} ${FLASH_OSC_TARGET})
    set_target_properties(${target} PROPERTIES OUTPUT_NAME ${product} PREFIX ""
      CUDA_SEPARABLE_COMPILATION ON CUDA_RESOLVE_DEVICE_SYMBOLS ON
      CUDA_ARCHITECTURES "${FLASH_CUDA_ARCH}-real" UNITY_BUILD OFF JOB_POOL_LINK flash_cuda_link)
    target_link_options(${target} PRIVATE "$<HOST_LINK:LINKER:--no-undefined>")
    if(FLASH_GLOBAL_DEVICE_LTO)
      target_link_options(${target} PRIVATE "$<DEVICE_LINK:-dlto>")
      target_link_libraries(${target} PRIVATE "${FLASH_SOLVERDX}")
    endif()
    if(mode STREQUAL normal)
      set_property(GLOBAL APPEND PROPERTY FLASH_NORMAL_TARGETS ${target})
    elseif(mode STREQUAL profile)
      set_property(GLOBAL APPEND PROPERTY FLASH_PROFILE_TARGETS ${target})
    elseif(mode STREQUAL ordered)
      set_property(GLOBAL APPEND PROPERTY FLASH_ORDERED_TARGETS ${target})
    elseif(mode STREQUAL ordered_profile)
      set_property(GLOBAL APPEND PROPERTY FLASH_ORDERED_PROFILE_TARGETS ${target})
    endif()
  endforeach()
endfunction()

# Read the maintained catalogue directly. CMake generates no CUDA bodies.
set(parameters "${FLASH_GPU}/data/libero_task_parameters.json")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${parameters}")
file(READ "${parameters}" catalogue)
string(JSON task_count LENGTH "${catalogue}" tasks)
math(EXPR last_task "${task_count}-1")
foreach(index RANGE 0 ${last_task})
  foreach(field nv nq nM njnt nu)
    string(JSON ${field} GET "${catalogue}" tasks ${index} dimensions ${field})
  endforeach()
  set(value "${nq};${nM};${njnt};${nu}")
  if(DEFINED dimensions_${nv} AND NOT "${dimensions_${nv}}" STREQUAL "${value}")
    message(FATAL_ERROR "NV alone no longer identifies a catalogue shape")
  endif()
  set(dimensions_${nv} "${value}")
  list(APPEND velocities ${nv})
endforeach()
list(REMOVE_DUPLICATES velocities)
list(SORT velocities COMPARE NATURAL)
foreach(nv IN LISTS velocities)
  flash_variant(${nv} ${dimensions_${nv}})
endforeach()
