set(CMAKE_CXX_STANDARD 17)
set(CMAKE_CUDA_STANDARD 17)
set(CMAKE_POSITION_INDEPENDENT_CODE ON)
set(CMAKE_EXPORT_COMPILE_COMMANDS ON)
set(FLASH_CUDA_ARCH 80 CACHE STRING "CUDA SM architecture")
set(FLASH_MATHDX_ROOT "" CACHE PATH "Installed NVIDIA MathDx directory")
set(FLASH_SUBSTEP_THREADS 64 CACHE STRING "Threads in each world block")
set(FLASH_REAL_PRECISIONS "64;32" CACHE STRING "Offline scalar precisions (32 and/or 64)")
option(FLASH_FAST_COMPILE "Use the minimal fast assembler policy" OFF)
option(FLASH_GLOBAL_DEVICE_LTO "Enable whole-program device LTO" OFF)
option(FLASH_NEWTON_ATOMIC_REDUCTIONS "Use atomic Newton transpose/Gram reductions" ON)
option(FLASH_NEWTON_JACOBIAN_CACHE "Cache position-generation sparse J/DJ and column lists" ON)
set(FLASH_NEWTON_TRANSPOSE_METHOD 0 CACHE STRING "Newton transpose: 0 auto, 1 atomic, 2 direct, 3/4/5 shared32/16/8, 6/7/8 CSC1/4/8")
if(NOT EXISTS "${FLASH_MATHDX_ROOT}/lib/libcusolverdx.a")
  message(FATAL_ERROR "Set FLASH_MATHDX_ROOT to the installed MathDx directory")
endif()
set(FLASH_GPU "${CMAKE_CURRENT_LIST_DIR}/..")
set(FLASH_STEP "${FLASH_GPU}/cuda/step")
set(FLASH_SOLVERDX "${FLASH_MATHDX_ROOT}/lib/libcusolverdx.a")
set_property(GLOBAL PROPERTY JOB_POOLS flash_cuda_compile=3 flash_cuda_link=1)

# Read the maintained catalogue directly. CMake generates no CUDA bodies.
set(parameters "${FLASH_GPU}/data/libero_task_parameters.json")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${parameters}")
file(READ "${parameters}" catalogue)
string(JSON task_count LENGTH "${catalogue}" tasks)
math(EXPR last_task "${task_count}-1")
foreach(index RANGE 0 ${last_task})
  foreach(field nv nq nM njnt nu)
    string(JSON ${field} GET "${catalogue}" tasks ${index} dimensions ${field})
  endforeach()
  set(value "${nq};${nM};${njnt};${nu}")
  if(DEFINED dimensions_${nv} AND NOT "${dimensions_${nv}}" STREQUAL "${value}")
    message(FATAL_ERROR "NV alone no longer identifies a catalogue shape")
  endif()
  set(dimensions_${nv} "${value}")
  list(APPEND velocities ${nv})
endforeach()
list(REMOVE_DUPLICATES velocities)
list(SORT velocities COMPARE NATURAL)
include("${CMAKE_CURRENT_LIST_DIR}/StagedSubstep.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/PeeledMotion.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/SubstepTargets.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/SubstepTests.cmake")
foreach(precision_bits IN LISTS FLASH_REAL_PRECISIONS)
  flash_add_precision(${precision_bits})
endforeach()
get_property(motion_targets GLOBAL PROPERTY FLASH_MOTION_TARGETS)
if(motion_targets)
  add_custom_target(flash_motion_substeps_all DEPENDS ${motion_targets} flash_substeps_all)
endif()
get_property(staged_targets GLOBAL PROPERTY FLASH_STAGED_TARGETS)
if(staged_targets)
  add_custom_target(flash_staged_substeps_all DEPENDS ${staged_targets} flash_substeps_all)
  get_property(staged_ordered_targets GLOBAL PROPERTY FLASH_STAGED_ORDERED_TARGETS)
  add_custom_target(flash_staged_substeps_ordered_all
    DEPENDS ${staged_ordered_targets} flash_substeps_ordered_all)
endif()
