function(flash_object name source)
  add_library(${name} OBJECT "${source}")
  target_link_libraries(${name} PRIVATE flash_cuda_options)
  set_target_properties(${name} PROPERTIES CUDA_SEPARABLE_COMPILATION ON
    CUDA_ARCHITECTURES "${FLASH_CUDA_ARCH}-real" UNITY_BUILD OFF JOB_POOL_COMPILE flash_cuda_compile)
  target_include_directories(${name} PRIVATE "${FLASH_MATHDX_ROOT}/include"
    "${FLASH_MATHDX_ROOT}/external/cutlass/include")
endfunction()

# Vendor instantiations are independent objects with a local device-LTO link.
# OSC is shared across dimensions; Newton operators are instantiated per NV.
function(flash_mathdx name source)
  flash_object(${name} "${source}")
  target_compile_definitions(${name} PRIVATE ${ARGN})
  set_target_properties(${name} PROPERTIES CUDA_ARCHITECTURES OFF)
  target_compile_options(${name} PRIVATE "-arch=lto_${FLASH_CUDA_ARCH}" -dlto)
  if(FLASH_GLOBAL_DEVICE_LTO)
    set(FLASH_VENDOR_INPUT "$<TARGET_OBJECTS:${name}>" PARENT_SCOPE)
    set(FLASH_VENDOR_TARGET ${name} PARENT_SCOPE)
    return()
  endif()
  if(CMAKE_CUDA_COMPILER_VERSION VERSION_LESS 13.2)
    message(FATAL_ERROR "Local MathDx prelink requires NVCC 13.2 or FLASH_GLOBAL_DEVICE_LTO=ON")
  endif()
  string(REGEX REPLACE "^flash_" "" stem "${name}")
  set(object "${CMAKE_CURRENT_BINARY_DIR}/device_modules/${stem}.o")
  set(fast_flags)
  if(FLASH_FAST_COMPILE)
    set(fast_flags -Xptxas=--Ofast-compile=min)
  endif()
  add_custom_command(OUTPUT "${object}"
    COMMAND "${CMAKE_COMMAND}" -E make_directory "${CMAKE_CURRENT_BINARY_DIR}/device_modules"
    COMMAND "${CMAKE_CUDA_COMPILER}" --relocatable-link -dlto "-arch=sm_${FLASH_CUDA_ARCH}"
      --split-compile=3 -Xcompiler=-fPIC ${fast_flags}
      $<TARGET_OBJECTS:${name}> "${FLASH_SOLVERDX}" -o "${object}"
    DEPENDS ${name} $<TARGET_OBJECTS:${name}> "${FLASH_SOLVERDX}"
    COMMAND_EXPAND_LISTS VERBATIM JOB_POOL flash_cuda_link)
  add_custom_target(${name}_device DEPENDS "${object}")
  set_source_files_properties("${object}" PROPERTIES GENERATED TRUE EXTERNAL_OBJECT TRUE)
  set(FLASH_VENDOR_INPUT "${object}" PARENT_SCOPE)
  set(FLASH_VENDOR_TARGET ${name}_device PARENT_SCOPE)
endfunction()
