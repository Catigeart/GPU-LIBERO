# Production objects and scalar/shape instantiations.
function(flash_precision_suffix precision_bits result)
  if(precision_bits STREQUAL "64")
    set(${result} "" PARENT_SCOPE)
  elseif(precision_bits STREQUAL "32")
    set(${result} "_fp32" PARENT_SCOPE)
  else()
    message(FATAL_ERROR "FLASH_REAL_PRECISIONS accepts only 32 and 64")
  endif()
endfunction()

function(flash_object name source precision_bits)
  flash_precision_suffix(${precision_bits} precision_suffix)
  add_library(${name} OBJECT "${source}")
  target_link_libraries(${name} PRIVATE flash_cuda_options${precision_suffix})
  set_target_properties(${name} PROPERTIES CUDA_SEPARABLE_COMPILATION ON
    CUDA_ARCHITECTURES "${FLASH_CUDA_ARCH}-real" UNITY_BUILD OFF JOB_POOL_COMPILE flash_cuda_compile
    EXCLUDE_FROM_ALL TRUE)
  target_include_directories(${name} PRIVATE "${FLASH_MATHDX_ROOT}/include"
    "${FLASH_MATHDX_ROOT}/external/cutlass/include")
endfunction()

# Vendor instantiations are independent objects with a local device-LTO link.
# OSC is shared across dimensions; Newton operators are instantiated per NV.
function(flash_mathdx name source precision_bits)
  flash_object(${name} "${source}" ${precision_bits})
  target_compile_definitions(${name} PRIVATE ${ARGN})
  set_target_properties(${name} PROPERTIES CUDA_ARCHITECTURES OFF)
  target_compile_options(${name} PRIVATE "-arch=lto_${FLASH_CUDA_ARCH}" -dlto)
  if(FLASH_GLOBAL_DEVICE_LTO OR NOT FLASH_BUILD_NATIVE)
    set(FLASH_VENDOR_INPUT "$<TARGET_OBJECTS:${name}>" PARENT_SCOPE)
    set(FLASH_VENDOR_TARGET ${name} PARENT_SCOPE)
    return()
  endif()
  if(CMAKE_CUDA_COMPILER_VERSION VERSION_LESS 13.2)
    message(FATAL_ERROR "Local MathDx prelink requires NVCC 13.2 or FLASH_GLOBAL_DEVICE_LTO=ON")
  endif()
  string(REGEX REPLACE "^flash_" "" stem "${name}")
  set(object "${CMAKE_CURRENT_BINARY_DIR}/device_modules/${stem}.o")
  set(fast_flags)
  if(FLASH_FAST_COMPILE)
    set(fast_flags -Xptxas=--Ofast-compile=min)
  endif()
  add_custom_command(OUTPUT "${object}"
    COMMAND "${CMAKE_COMMAND}" -E make_directory "${CMAKE_CURRENT_BINARY_DIR}/device_modules"
    COMMAND "${CMAKE_CUDA_COMPILER}" --relocatable-link -dlto "-arch=sm_${FLASH_CUDA_ARCH}"
      --split-compile=3 -Xcompiler=-fPIC ${fast_flags}
      $<TARGET_OBJECTS:${name}> "${FLASH_SOLVERDX}" -o "${object}"
    DEPENDS ${name} $<TARGET_OBJECTS:${name}> "${FLASH_SOLVERDX}"
    COMMAND_EXPAND_LISTS VERBATIM JOB_POOL flash_cuda_link)
  add_custom_target(${name}_device DEPENDS "${object}")
  set_source_files_properties("${object}" PROPERTIES GENERATED TRUE EXTERNAL_OBJECT TRUE)
  set(FLASH_VENDOR_INPUT "${object}" PARENT_SCOPE)
  set(FLASH_VENDOR_TARGET ${name}_device PARENT_SCOPE)
endfunction()
function(flash_variant nv nq nm nj nu precision_bits osc_input osc_target)
  flash_precision_suffix(${precision_bits} precision_suffix)
  foreach(group normal profile ordered ordered_profile)
    set(${group}_targets "")
  endforeach()
  flash_shape_suffix(${nv} ${nq} ${nm} ${nj} ${nu} suffix)
  if(suffix STREQUAL "_nv39")
    set(suffix "") # Preserve the original development target and binary.
  endif()
  set(definitions FLASH_SUBSTEP_NV=${nv} FLASH_SUBSTEP_NQ=${nq} FLASH_SUBSTEP_NM=${nm}
    FLASH_SUBSTEP_NJ=${nj} FLASH_SUBSTEP_NU=${nu} FLASH_SUBSTEP_CONTACTS=5000)
  flash_mathdx(flash_newton_mathdx${precision_suffix}${suffix} "${FLASH_STEP}/instantiations/newton_mathdx.cu" ${precision_bits} ${definitions})
  set(mathdx_input "${FLASH_VENDOR_INPUT}")
  set(mathdx_target ${FLASH_VENDOR_TARGET})
  foreach(module fused_substep newton_solver)
    set(object flash_${module}${precision_suffix}${suffix})
    flash_object(${object} "${FLASH_STEP}/${module}.cu" ${precision_bits})
    target_compile_definitions(${object} PRIVATE ${definitions})
    if(module STREQUAL newton_solver)
      target_compile_definitions(${object} PRIVATE
        FLASH_NEWTON_ATOMIC_REDUCTIONS=$<BOOL:${FLASH_NEWTON_ATOMIC_REDUCTIONS}>)
    endif()
    target_compile_options(${object} PRIVATE --split-compile=3)
    if(FLASH_GLOBAL_DEVICE_LTO)
      set_target_properties(${object} PROPERTIES CUDA_ARCHITECTURES OFF)
      target_compile_options(${object} PRIVATE "-arch=lto_${FLASH_CUDA_ARCH}" -dlto)
    endif()
  endforeach()
  set(profile_solver flash_newton_solver_profile${precision_suffix}${suffix})
  # Keep full-substep markers out of the normal numerical object.
  set(profile_fused flash_fused_substep_profile${precision_suffix}${suffix})
  flash_object(${profile_fused} "${FLASH_STEP}/fused_substep.cu" ${precision_bits})
  set_target_properties(${profile_fused} PROPERTIES EXCLUDE_FROM_ALL TRUE)
  target_compile_definitions(${profile_fused} PRIVATE ${definitions} FLASH_SUBSTEP_PROFILE=1)
  target_compile_options(${profile_fused} PRIVATE --split-compile=3)
  if(FLASH_GLOBAL_DEVICE_LTO)
    set_target_properties(${profile_fused} PROPERTIES CUDA_ARCHITECTURES OFF)
    target_compile_options(${profile_fused} PRIVATE "-arch=lto_${FLASH_CUDA_ARCH}" -dlto)
  endif()
  flash_object(${profile_solver} "${FLASH_STEP}/newton_solver.cu" ${precision_bits})
  set_target_properties(${profile_solver} PROPERTIES EXCLUDE_FROM_ALL TRUE)
  target_compile_definitions(${profile_solver} PRIVATE ${definitions} FLASH_NEWTON_PROFILE=1
    FLASH_NEWTON_ATOMIC_REDUCTIONS=$<BOOL:${FLASH_NEWTON_ATOMIC_REDUCTIONS}>)
  target_compile_options(${profile_solver} PRIVATE --split-compile=3)
  if(FLASH_GLOBAL_DEVICE_LTO)
    set_target_properties(${profile_solver} PROPERTIES CUDA_ARCHITECTURES OFF)
    target_compile_options(${profile_solver} PRIVATE "-arch=lto_${FLASH_CUDA_ARCH}" -dlto)
  endif()
  # Ordered comparison products coexist in this build tree. Their optional
  # solver objects share the fusion/vendor objects and require no reconfigure.
  set(ordered_solver flash_newton_solver${precision_suffix}${suffix})
  set(ordered_profile_solver ${profile_solver})
  if(FLASH_NEWTON_ATOMIC_REDUCTIONS)
    foreach(kind ordered ordered_profile)
      set(object flash_newton_solver_${kind}${precision_suffix}${suffix})
      flash_object(${object} "${FLASH_STEP}/newton_solver.cu" ${precision_bits})
      set_target_properties(${object} PROPERTIES EXCLUDE_FROM_ALL TRUE)
      target_compile_definitions(${object} PRIVATE ${definitions} FLASH_NEWTON_ATOMIC_REDUCTIONS=0)
      target_compile_options(${object} PRIVATE --split-compile=3)
      if(kind STREQUAL ordered_profile)
        target_compile_definitions(${object} PRIVATE FLASH_NEWTON_PROFILE=1)
      endif()
      if(FLASH_GLOBAL_DEVICE_LTO)
        set_target_properties(${object} PROPERTIES CUDA_ARCHITECTURES OFF)
        target_compile_options(${object} PRIVATE "-arch=lto_${FLASH_CUDA_ARCH}" -dlto)
      endif()
    endforeach()
    set(ordered_solver flash_newton_solver_ordered${precision_suffix}${suffix})
    set(ordered_profile_solver flash_newton_solver_ordered_profile${precision_suffix}${suffix})
  endif()
  foreach(mode normal profile ordered ordered_profile post_profile osc_profile)
    set(product substep${suffix}${precision_suffix})
    set(solver flash_newton_solver${precision_suffix}${suffix})
    set(fused flash_fused_substep${precision_suffix}${suffix})
    set(post flash_post_solver${precision_suffix})
    set(osc flash_osc_solver${precision_suffix})
    set(pipeline flash_controller_pipeline${precision_suffix})
    set(profile_definitions)
    set(excluded EXCLUDE_FROM_ALL)
    set(atomic_input)
    if(FLASH_NEWTON_ATOMIC_REDUCTIONS AND NOT mode MATCHES "ordered")
      set(atomic_input $<TARGET_OBJECTS:flash_newton_atomic${precision_suffix}>
        $<TARGET_OBJECTS:flash_newton_transpose${precision_suffix}> $<TARGET_OBJECTS:flash_newton_jacobian_cache${precision_suffix}>)
    endif()
    if(mode MATCHES "profile")
      set(product substep_newton_profile${suffix}${precision_suffix})
      set(solver ${profile_solver})
      set(fused ${profile_fused})
      set(post flash_post_solver_profile${precision_suffix})
      set(profile_definitions FLASH_SUBSTEP_PROFILE=1)
      set(excluded EXCLUDE_FROM_ALL)
    endif()
    if(mode MATCHES "ordered")
      set(product "${product}_ordered")
      set(solver ${ordered_solver})
      if(mode STREQUAL ordered_profile)
        set(solver ${ordered_profile_solver})
      endif()
      set(excluded EXCLUDE_FROM_ALL)
    endif()
    # Post-only instrumentation reuses the ordinary numerical Newton/fusion
    # objects. Profiling Post never recompiles the Newton iteration body.
    if(mode STREQUAL post_profile)
      set(product substep_post_profile${suffix}${precision_suffix})
      set(solver flash_newton_solver${precision_suffix}${suffix})
      set(fused flash_fused_substep${precision_suffix}${suffix})
      set(post flash_post_solver_profile${precision_suffix})
      set(profile_definitions)
      set(excluded EXCLUDE_FROM_ALL)
    endif()
    if(mode STREQUAL osc_profile)
      set(product substep_osc_profile${suffix}${precision_suffix})
      set(solver flash_newton_solver${precision_suffix}${suffix})
      set(fused flash_fused_substep${precision_suffix}${suffix})
      set(post flash_post_solver${precision_suffix})
      set(osc flash_osc_solver_profile${precision_suffix})
      set(pipeline flash_controller_pipeline_profile${precision_suffix})
      set(profile_definitions)
      set(excluded EXCLUDE_FROM_ALL)
    endif()
    set(target flash_${product})
    add_library(${target} SHARED ${excluded} "${FLASH_STEP}/substep_launch.cu"
      $<TARGET_OBJECTS:${fused}> $<TARGET_OBJECTS:${solver}> $<TARGET_OBJECTS:${post}>
      $<TARGET_OBJECTS:${osc}> $<TARGET_OBJECTS:${pipeline}>
      ${atomic_input} ${mathdx_input} ${osc_input})
    target_link_libraries(${target} PRIVATE flash_cuda_options${precision_suffix})
    target_compile_definitions(${target} PRIVATE ${definitions} ${profile_definitions})
    add_dependencies(${target} ${mathdx_target} ${osc_target})
    set_target_properties(${target} PROPERTIES OUTPUT_NAME ${product} PREFIX ""
      CUDA_SEPARABLE_COMPILATION ON CUDA_RESOLVE_DEVICE_SYMBOLS ON
      CUDA_ARCHITECTURES "${FLASH_CUDA_ARCH}-real" UNITY_BUILD OFF JOB_POOL_LINK flash_cuda_link)
    target_link_options(${target} PRIVATE "$<HOST_LINK:LINKER:--no-undefined>")
    if(FLASH_GLOBAL_DEVICE_LTO)
      target_link_options(${target} PRIVATE "$<DEVICE_LINK:-dlto>")
      target_link_libraries(${target} PRIVATE "${FLASH_SOLVERDX}")
    endif()
    if(mode STREQUAL normal)
      list(APPEND normal_targets ${target})
    elseif(mode STREQUAL profile)
      list(APPEND profile_targets ${target})
    elseif(mode STREQUAL ordered)
      list(APPEND ordered_targets ${target})
    elseif(mode STREQUAL ordered_profile)
      list(APPEND ordered_profile_targets ${target})
    endif()
  endforeach()
  foreach(group normal profile ordered ordered_profile)
    set(FLASH_VARIANT_${group}_TARGETS ${${group}_targets} PARENT_SCOPE)
  endforeach()
  flash_add_newton_cone_fixture("${suffix}" "${precision_bits}" "${mathdx_input}" "${mathdx_target}" ${definitions})
  if(precision_bits STREQUAL "64")
    flash_add_peeled_motion("${suffix}" "${mathdx_input}" "${mathdx_target}"
      "${osc_input}" "${osc_target}" ${definitions})
    flash_add_staged_substep("${suffix}" "${mathdx_input}" "${mathdx_target}"
      "${osc_input}" "${osc_target}" ${definitions})
  endif()
  if(suffix STREQUAL "")
    flash_add_newton_line_fixture("${precision_bits}" "${mathdx_input}" "${mathdx_target}" ${definitions})
  endif()
  if(FLASH_NEWTON_ATOMIC_REDUCTIONS AND
      (nv EQUAL 39 OR (precision_bits STREQUAL "64" AND (nv EQUAL 21 OR nv EQUAL 57))))
    flash_add_newton_replay_probe("${suffix}" "${precision_bits}" "${mathdx_input}" "${mathdx_target}" "${osc_input}" "${osc_target}" ${definitions})
    flash_add_newton_replay_probe("${suffix}" "${precision_bits}" "${mathdx_input}" "${mathdx_target}" "${osc_input}" "${osc_target}" PROFILE ${definitions})
  endif()
endfunction()

function(flash_add_precision precision_bits)
    flash_precision_suffix(${precision_bits} precision_suffix)
  add_library(flash_cuda_options${precision_suffix} INTERFACE)
  target_include_directories(flash_cuda_options${precision_suffix} INTERFACE "${FLASH_GPU}/cuda/common")
  target_compile_definitions(flash_cuda_options${precision_suffix} INTERFACE
    FLASH_REAL_BITS=${precision_bits} FLASH_SUBSTEP_SM=${FLASH_CUDA_ARCH}0 FLASH_SUBSTEP_THREADS=${FLASH_SUBSTEP_THREADS})
  target_compile_options(flash_cuda_options${precision_suffix} INTERFACE
    "$<$<COMPILE_LANGUAGE:CUDA>:-lineinfo;--fmad=true;--prec-div=true;--prec-sqrt=true;--ftz=false;--expt-relaxed-constexpr>")
  if(FLASH_FAST_COMPILE)
    target_compile_options(flash_cuda_options${precision_suffix} INTERFACE "$<$<COMPILE_LANGUAGE:CUDA>:-Xptxas=--Ofast-compile=min>")
  endif()
  flash_mathdx(flash_osc_mathdx${precision_suffix} "${FLASH_STEP}/instantiations/osc_mathdx.cu" ${precision_bits})
  set(FLASH_OSC_INPUT "${FLASH_VENDOR_INPUT}")
  set(FLASH_OSC_TARGET ${FLASH_VENDOR_TARGET})

  # Fixed robot/controller dimensions: one ordinary and one optional profile object
  # serve every scene shape. Numerical edits never rebuild the outer fused body.
  foreach(mode normal profile)
    set(osc_object flash_osc_solver${precision_suffix})
    if(mode STREQUAL profile)
      set(osc_object flash_osc_solver_profile${precision_suffix})
    endif()
    flash_object(${osc_object} "${FLASH_GPU}/cuda/control/osc_solver.cu" ${precision_bits})
    target_compile_options(${osc_object} PRIVATE --split-compile=3)
    if(mode STREQUAL profile)
      set_target_properties(${osc_object} PROPERTIES EXCLUDE_FROM_ALL TRUE)
      target_compile_definitions(${osc_object} PRIVATE FLASH_OSC_PROFILE=1)
    endif()
    if(FLASH_GLOBAL_DEVICE_LTO)
      set_target_properties(${osc_object} PROPERTIES CUDA_ARCHITECTURES OFF)
      target_compile_options(${osc_object} PRIVATE "-arch=lto_${FLASH_CUDA_ARCH}" -dlto)
    endif()
  endforeach()
  # Optional MJWarp frontend shares the exact maintained controller object.
  set(mjwarp_controller flash_mjwarp_controller${precision_suffix})
  add_library(${mjwarp_controller} SHARED EXCLUDE_FROM_ALL
    "${FLASH_GPU}/cuda/control/mjwarp_controller.cu"
    $<TARGET_OBJECTS:flash_osc_solver${precision_suffix}> ${FLASH_OSC_INPUT})
  target_link_libraries(${mjwarp_controller} PRIVATE flash_cuda_options${precision_suffix})
  add_dependencies(${mjwarp_controller} ${FLASH_OSC_TARGET})
  set_target_properties(${mjwarp_controller} PROPERTIES PREFIX "" OUTPUT_NAME "mjwarp_controller${precision_suffix}"
    CUDA_SEPARABLE_COMPILATION ON CUDA_RESOLVE_DEVICE_SYMBOLS ON
    CUDA_ARCHITECTURES "${FLASH_CUDA_ARCH}-real" JOB_POOL_LINK flash_cuda_link)
  if(FLASH_GLOBAL_DEVICE_LTO OR NOT FLASH_BUILD_NATIVE)
    target_link_options(${mjwarp_controller} PRIVATE "$<DEVICE_LINK:-dlto>")
    target_link_libraries(${mjwarp_controller} PRIVATE "${FLASH_SOLVERDX}")
  endif()

  flash_add_osc_replay_probe(${precision_bits} "${FLASH_OSC_INPUT}" "${FLASH_OSC_TARGET}")

  if(NOT FLASH_BUILD_NATIVE)
    return()
  endif()

  # One dimension-general device object; no MathDx instantiations or shared arrays.
  flash_object(flash_newton_atomic${precision_suffix} "${FLASH_STEP}/newton_atomic.cu" ${precision_bits})
  # This small independent unit keeps full assembler optimization even in the
  # developer tree. Source options follow the inherited fast-compile flags.
  set_source_files_properties("${FLASH_STEP}/newton_atomic.cu" PROPERTIES
    COMPILE_OPTIONS "-Xptxas=--Ofast-compile=0")
  set_target_properties(flash_newton_atomic${precision_suffix} PROPERTIES EXCLUDE_FROM_ALL TRUE)
  target_compile_options(flash_newton_atomic${precision_suffix} PRIVATE --split-compile=3)
  flash_object(flash_newton_transpose${precision_suffix} "${FLASH_STEP}/newton_transpose.cu" ${precision_bits})
  set_source_files_properties("${FLASH_STEP}/newton_transpose.cu" PROPERTIES
    COMPILE_OPTIONS "-Xptxas=--Ofast-compile=0")
  set_target_properties(flash_newton_transpose${precision_suffix} PROPERTIES EXCLUDE_FROM_ALL TRUE)
  target_compile_options(flash_newton_transpose${precision_suffix} PRIVATE --split-compile=3)
  flash_object(flash_newton_jacobian_cache${precision_suffix} "${FLASH_STEP}/newton_jacobian_cache.cu" ${precision_bits})
  set_source_files_properties("${FLASH_STEP}/newton_jacobian_cache.cu" PROPERTIES
    COMPILE_OPTIONS "-Xptxas=--Ofast-compile=0")
  set_target_properties(flash_newton_jacobian_cache${precision_suffix} PROPERTIES EXCLUDE_FROM_ALL TRUE)
  target_compile_options(flash_newton_jacobian_cache${precision_suffix} PRIVATE --split-compile=3)
  target_compile_definitions(flash_newton_jacobian_cache${precision_suffix} PRIVATE
    FLASH_NEWTON_JACOBIAN_CACHE=$<BOOL:${FLASH_NEWTON_JACOBIAN_CACHE}>
    FLASH_NEWTON_TRANSPOSE_METHOD=${FLASH_NEWTON_TRANSPOSE_METHOD})
  if(FLASH_GLOBAL_DEVICE_LTO)
    set_target_properties(flash_newton_atomic${precision_suffix} PROPERTIES CUDA_ARCHITECTURES OFF)
    target_compile_options(flash_newton_atomic${precision_suffix} PRIVATE "-arch=lto_${FLASH_CUDA_ARCH}" -dlto)
    set_target_properties(flash_newton_transpose${precision_suffix} PROPERTIES CUDA_ARCHITECTURES OFF)
    target_compile_options(flash_newton_transpose${precision_suffix} PRIVATE "-arch=lto_${FLASH_CUDA_ARCH}" -dlto)
    set_target_properties(flash_newton_jacobian_cache${precision_suffix} PROPERTIES CUDA_ARCHITECTURES OFF)
    target_compile_options(flash_newton_jacobian_cache${precision_suffix} PRIVATE "-arch=lto_${FLASH_CUDA_ARCH}" -dlto)
  endif()

  # Post owns no NV-sized storage or MathDx instantiations. Keep it independent
  # from Newton so its numerical changes compile once for all 130 tasks.
  foreach(mode normal profile)
    set(post_object flash_post_solver${precision_suffix})
    if(mode STREQUAL profile)
      set(post_object flash_post_solver_profile${precision_suffix})
    endif()
    flash_object(${post_object} "${FLASH_GPU}/cuda/postprocess/post_solver.cu" ${precision_bits})
    target_compile_options(${post_object} PRIVATE --split-compile=3)
    if(mode STREQUAL profile)
      set_target_properties(${post_object} PROPERTIES EXCLUDE_FROM_ALL TRUE)
      target_compile_definitions(${post_object} PRIVATE FLASH_POST_PROFILE=1)
    endif()
    if(FLASH_GLOBAL_DEVICE_LTO)
      set_target_properties(${post_object} PROPERTIES CUDA_ARCHITECTURES OFF)
      target_compile_options(${post_object} PRIVATE "-arch=lto_${FLASH_CUDA_ARCH}" -dlto)
    endif()
  endforeach()



  # Gather/scheduling is scene-independent; controller edits compile only once.
  foreach(mode normal profile)
    set(pipeline flash_controller_pipeline${precision_suffix})
    if(mode STREQUAL profile)
      set(pipeline flash_controller_pipeline_profile${precision_suffix})
    endif()
    flash_object(${pipeline} "${FLASH_GPU}/cuda/control/controller_pipeline.cu" ${precision_bits})
    target_compile_options(${pipeline} PRIVATE --split-compile=3)
    if(mode STREQUAL profile)
      set_target_properties(${pipeline} PROPERTIES EXCLUDE_FROM_ALL TRUE)
      target_compile_definitions(${pipeline} PRIVATE FLASH_OSC_PROFILE=1)
    endif()
    if(FLASH_GLOBAL_DEVICE_LTO)
      set_target_properties(${pipeline} PROPERTIES CUDA_ARCHITECTURES OFF)
      target_compile_options(${pipeline} PRIVATE "-arch=lto_${FLASH_CUDA_ARCH}" -dlto)
    endif()
  endforeach()

  foreach(group normal profile ordered ordered_profile)
    set(${group}_targets "")
  endforeach()
  foreach(shape IN LISTS shapes)
    flash_variant(${dimensions_${shape}} ${precision_bits} "${FLASH_OSC_INPUT}" "${FLASH_OSC_TARGET}")
    foreach(group normal profile ordered ordered_profile)
      list(APPEND ${group}_targets ${FLASH_VARIANT_${group}_TARGETS})
    endforeach()
  endforeach()
  add_custom_target(flash_substeps_all${precision_suffix} DEPENDS ${normal_targets})
  add_custom_target(flash_substeps_profile_all${precision_suffix} DEPENDS ${profile_targets})
  add_custom_target(flash_substeps_ordered_all${precision_suffix} DEPENDS ${ordered_targets})
  add_custom_target(flash_substeps_ordered_profile_all${precision_suffix} DEPENDS ${ordered_profile_targets})
  flash_add_substep_tests(${precision_bits} "${FLASH_OSC_INPUT}" "${FLASH_OSC_TARGET}")
endfunction()
