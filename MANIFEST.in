include README.md LICENSE setup.py pyproject.toml CMakeLists.txt
recursive-include libero *.cmake *.py *.cu *.cuh *.h *.hpp *.c *.cpp *.json *.txt *.md *.xml *.bddl *.yaml *.yml *.ps1
recursive-include scripts *.py *.cu *.cuh *.h *.hpp *.c *.cpp *.xml *.json *.yaml *.yml *.ps1
